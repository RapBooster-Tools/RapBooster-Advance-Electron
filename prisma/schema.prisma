// RapBooster Advance — full schema (SPRINTS.md §4).
//
// Prisma 7: no datasource url here. The CLI reads it from prisma.config.ts and
// the runtime hands it to the driver adapter, because in Electron the database
// path (app.getPath('userData')) is only known at runtime.
//
// SQLite has no native enums; the string unions are defined once in
// shared/types.ts and validated by zod at every boundary.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────── Licensing ───────────────────────────────

model License {
  id                String    @id @default("singleton")
  keyEncrypted      String
  keyMasked         String
  status            String
  remarks           String?
  deviceFingerprint String
  deviceName        String?
  activatedAt       DateTime?
  expiresAt         DateTime?
  lastValidatedAt   DateTime?
  graceUntil        DateTime?
  serverPayload     String?
  signature         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ──────────────────────────────── Devices ────────────────────────────────

model Device {
  id                  String    @id @default(cuid())
  name                String
  phone               String?
  jid                 String?
  status              String    @default("disconnected")
  authFolder          String
  lastActiveAt        DateTime?
  lastError           String?
  consecutiveFailures Int       @default(0)
  dailySentCount      Int       @default(0)
  dailyCountResetAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Warmup (IMPROVEMENT-PLAN.md, D89): a new number ramps its daily cap up
  // over its first days instead of sending at full volume immediately.
  warmupEnabled     Boolean   @default(false)
  warmupStartedAt   DateTime?
  // Health breaker: set when recent sends fail at a rate that suggests WhatsApp
  // is restricting the account. Campaigns skip the device until it passes.
  healthPausedUntil DateTime?
  healthReason      String?
  /// WhatsApp Business account — labels and catalogs exist only there.
  isBusiness        Boolean   @default(false)

  campaignLinks   CampaignDevice[]
  recipients      CampaignRecipient[]
  groups          Group[]
  chats           Chat[]
  groupCreateJobs GroupCreateJob[]
  channels        Channel[]
  scheduledPosts  ScheduledPost[]
  callEvents      CallEvent[]
  waContacts      WaContact[]

  @@index([status])
}

// ──────────────────────────────── Contacts ───────────────────────────────

model ContactList {
  id           String   @id @default(cuid())
  name         String   @unique
  /// JSON string[] — always begins ["Name","Mobile"]
  fields       String
  /// Denormalized; maintained inside the same transaction as contact writes
  contactCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts  Contact[]
  campaigns CampaignList[]
}

model Contact {
  id        String   @id @default(cuid())
  listId    String
  /// Promoted out of `data` so it can be indexed
  name      String
  /// Normalized to E.164, promoted so it can be indexed
  phone     String
  /// JSON object of every field, including this list's custom columns
  data      String   @default("{}")
  isValid   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Result of the last "is this number on WhatsApp" check: unknown | valid | invalid.
  waStatus    String    @default("unknown")
  waCheckedAt DateTime?

  list        ContactList          @relation(fields: [listId], references: [id], onDelete: Cascade)
  recipients  CampaignRecipient[]
  tags        ContactTag[]
  enrollments SequenceEnrollment[]

  @@unique([listId, phone])
  @@index([listId, name])
  @@index([phone])
  @@index([waStatus])
}

// ───────────────────────────── Tags and opt-outs ─────────────────────────────

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#0078d4")
  /// manual | wa_label — WhatsApp Business labels are mirrored as tags.
  source    String   @default("manual")
  /// "<deviceId>:<labelId>" when source = wa_label.
  waLabelId String?
  createdAt DateTime @default(now())

  contacts  ContactTag[]
  campaigns CampaignTag[]

  @@index([waLabelId])
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

/// Numbers that must never be messaged by a campaign, sequence or bot. Keyed by
/// normalized phone so it applies across every list the number appears in.
model Suppression {
  phone     String   @id
  reason    String?
  /// manual | stop_keyword | import
  source    String   @default("manual")
  createdAt DateTime @default(now())
}

// ─────────────────────────────── Templates ───────────────────────────────

model Template {
  id             String   @id @default(cuid())
  name           String
  type           String
  content        String
  mediaType      String?
  mediaPath      String?
  /// JSON string[] — rows of the single-select list an interactive template sends
  options        String?
  /// JSON TemplateButton[] — { type, label, value? }. Legacy rows hold string[].
  buttons        String?
  /// Small print under the body, on button and interactive templates
  footer         String?
  /// Label on the control that opens an interactive template's list
  listButtonText String?
  /// JSON payload for the rich types (voice, sticker, location, contact, poll,
  /// event, product). Shape per type lives in shared/rich-message.ts.
  extra          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaigns     Campaign[]
  groupJobs     GroupSendJob[]
  keywordRules  KeywordRule[]
  sequenceSteps SequenceStep[]
}

// ─────────────────────────────── Campaigns ───────────────────────────────

model Campaign {
  id            String    @id @default(cuid())
  name          String
  status        String    @default("draft")
  templateId    String
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  delayFrom     Int       @default(0)
  delayTo       Int       @default(5)
  sleepDuration Int       @default(10)
  sleepAfter    Int       @default(10)
  retryAttempts Int       @default(2)
  totalCount    Int       @default(0)
  sentCount     Int       @default(0)
  failedCount   Int       @default(0)
  lastError     String?
  /// Verify each number is on WhatsApp before sending; non-users are skipped.
  checkNumbers  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  template   Template            @relation(fields: [templateId], references: [id])
  devices    CampaignDevice[]
  lists      CampaignList[]
  tags       CampaignTag[]
  recipients CampaignRecipient[]

  @@index([status, scheduledAt])
}

model CampaignDevice {
  campaignId String
  deviceId   String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([campaignId, deviceId])
  @@index([deviceId])
}

model CampaignList {
  campaignId String
  listId     String

  campaign Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  list     ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([campaignId, listId])
  @@index([listId])
}

/// The durable send queue — one row per recipient. This is what makes campaigns
/// pausable and crash-resumable (SPRINTS.md §6.2–§6.4).
model CampaignTag {
  campaignId String
  tagId      String
  /// include | exclude
  mode       String @default("include")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([campaignId, tagId])
  @@index([tagId])
}

model CampaignRecipient {
  id          String    @id @default(cuid())
  campaignId  String
  contactId   String
  deviceId    String
  /// Snapshot, so editing a contact mid-run cannot corrupt the queue
  phone       String
  status      String    @default("pending")
  attempts    Int       @default(0)
  messageId   String?
  error       String?
  /// Set when the row is claimed (flipped to "sending")
  claimedAt   DateTime?
  sentAt      DateTime?
  // Analytics (IMPROVEMENT-PLAN.md Phase 3): from WhatsApp receipts and inbound
  // replies within the attribution window.
  deliveredAt DateTime?
  readAt      DateTime?
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  device   Device   @relation(fields: [deviceId], references: [id])

  /// Hard guarantee: a contact can never be queued twice in one campaign
  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([deviceId, status])
  @@index([messageId])
  @@index([phone, sentAt])
}

// ───────────────────────────────── Groups ────────────────────────────────

model Group {
  id           String   @id
  deviceId     String
  name         String
  memberCount  Int      @default(0)
  isAdmin      Boolean  @default(false)
  isCommunity  Boolean  @default(false)
  /// The community this group is linked into, when it is.
  parentId     String?
  /// Only admins can send messages.
  announce     Boolean  @default(false)
  /// Only admins can edit group info.
  restrict     Boolean  @default(false)
  joinApproval Boolean  @default(false)
  syncedAt     DateTime @default(now())

  device  Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  targets GroupSendTarget[]

  @@index([deviceId])
}

model GroupSendJob {
  id           String    @id @default(cuid())
  templateId   String
  status       String    @default("pending")
  delaySeconds Int       @default(2)
  totalCount   Int       @default(0)
  sentCount    Int       @default(0)
  failedCount  Int       @default(0)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  template Template          @relation(fields: [templateId], references: [id])
  targets  GroupSendTarget[]

  @@index([status])
}

model GroupSendTarget {
  id      String    @id @default(cuid())
  jobId   String
  groupId String
  status  String    @default("pending")
  error   String?
  sentAt  DateTime?

  job   GroupSendJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  group Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([groupId])
}

model GroupCreateJob {
  id               String    @id @default(cuid())
  deviceId         String
  prefix           String
  /// "number" | "alphabet" | "timestamp" | "none"
  suffixRule       String
  count            Int
  delaySeconds     Int       @default(2)
  /// JSON string[] of ContactList ids to seed members from
  listIds          String    @default("[]")
  contactsPerGroup Int       @default(0)
  status           String    @default("pending")
  createdCount     Int       @default(0)
  failedCount      Int       @default(0)
  /// JSON — per-group outcome, including per-participant add failures
  resultLog        String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([status])
}

// ───────────────────────────── Inbox / chatbot ───────────────────────────

model Chat {
  id              String    @id
  deviceId        String
  name            String
  phone           String
  isGroup         Boolean   @default(false)
  lastMessageAt   DateTime?
  lastMessage     String?
  unreadCount     Int       @default(0)
  isEscalated     Boolean   @default(false)
  escalatedAt     DateTime?
  /// When the welcome message went out — at most once per chat.
  welcomedAt      DateTime?
  /// Last away message, so it repeats at most once per cooldown.
  lastAwayAt      DateTime?
  autoReplyOptOut Boolean   @default(false)
  createdAt       DateTime  @default(now())

  device    Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  messages  Message[]
  drafts    AiDraft[]
  notes     ChatNote[]
  scheduled ScheduledMessage[]
  flowState FlowSession?

  @@index([deviceId, lastMessageAt])
}

model Message {
  id        String   @id
  chatId    String
  direction String
  type      String
  body      String?
  mediaPath String?
  mediaType String?
  fileName  String?
  fileSize  Int?
  /// JSON string[]
  buttons   String?
  status    String   @default("sent")
  isAiReply Boolean  @default(false)
  timestamp DateTime

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, timestamp])
}

model ChatbotConfig {
  id                    String   @id @default("singleton")
  enabled               Boolean  @default(true)
  systemInstructions    String   @default("")
  businessName          String?
  businessEmail         String?
  businessPhone         String?
  responseDelay         Int      @default(2)
  tone                  String   @default("professional")
  industry              String?
  primaryGoal           String   @default("support")
  responseStyle         String   @default("conversational")
  language              String   @default("english")
  escalationTrigger     String   @default("keywords")
  /// JSON string[]
  escalationKeywords    String   @default("[]")
  escalationMessage     String?
  confidenceThreshold   Int      @default(75)
  /// escalationTrigger = messages: hand over after this many bot replies in a chat.
  escalateAfterMessages Int      @default(0)
  /// escalationTrigger = time: hand over when a conversation has run this long.
  escalateAfterMinutes  Int      @default(0)
  /// Raw bulk text, "Name | Description" per line
  products              String   @default("")
  /// Raw bulk text, "Q: … | A: …" per line
  knowledgeBase         String   @default("")
  updatedAt             DateTime @updatedAt
}

// ──────────────────────────────── Settings ───────────────────────────────

model Setting {
  key         String   @id
  value       String
  isEncrypted Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────── Channels and status ───────────────────────────

/// A WhatsApp Channel (newsletter) this device owns or follows.
model Channel {
  id          String   @id
  deviceId    String
  name        String
  description String?
  /// owner | admin | subscriber
  role        String   @default("owner")
  subscribers Int      @default(0)
  inviteCode  String?
  syncedAt    DateTime @default(now())

  device Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  posts  ScheduledPost[]

  @@index([deviceId])
}

/// A status (story) update or channel post, sent now or at `scheduledAt`.
model ScheduledPost {
  id              String    @id @default(cuid())
  deviceId        String
  /// status | channel
  target          String
  channelId       String?
  /// text | image | video
  kind            String
  body            String    @default("")
  mediaPath       String?
  backgroundColor String?
  /// Status audience: contact lists whose numbers may view it. Empty = every
  /// contact on file.
  listIds         String    @default("[]")
  scheduledAt     DateTime
  /// scheduled | posting | posted | failed | cancelled
  status          String    @default("scheduled")
  postedAt        DateTime?
  messageId       String?
  error           String?
  createdAt       DateTime  @default(now())

  device  Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([deviceId])
}

// ──────────────────────────────── Automation ───────────────────────────────

/// Rule-based auto-reply, evaluated before the AI bot.
model KeywordRule {
  id              String    @id @default(cuid())
  name            String
  keywords        String    @default("[]")
  /// contains | exact | starts_with
  matchType       String    @default("contains")
  replyText       String?
  templateId      String?
  /// Devices this rule answers on; empty = all.
  deviceIds       String    @default("[]")
  enabled         Boolean   @default(true)
  priority        Int       @default(0)
  cooldownMinutes Int       @default(10)
  hitCount        Int       @default(0)
  lastHitAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  template Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  hits     KeywordRuleHit[]

  @@index([enabled, priority])
}

/// Last time a rule answered a chat, so a rule cannot loop with another bot.
model KeywordRuleHit {
  ruleId String
  chatId String
  lastAt DateTime

  rule KeywordRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([ruleId, chatId])
}

model Webhook {
  id              String    @id @default(cuid())
  url             String
  /// JSON array of event names.
  events          String    @default("[]")
  /// HMAC signing secret, stored through secure-store.
  secret          String
  enabled         Boolean   @default(true)
  lastStatus      Int?
  lastError       String?
  lastDeliveredAt DateTime?
  createdAt       DateTime  @default(now())

  deliveries WebhookDelivery[]
}

/// Persisted outbox, so a delivery survives a restart and retries with backoff.
model WebhookDelivery {
  id            String    @id @default(cuid())
  webhookId     String
  event         String
  payload       String
  /// pending | delivered | failed
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([webhookId])
}

/// A drip sequence: timed follow-up messages that stop when the contact replies.
model Sequence {
  id          String   @id @default(cuid())
  name        String
  /// active | paused | archived
  status      String   @default("active")
  deviceIds   String   @default("[]")
  stopOnReply Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([status])
}

model SequenceStep {
  id           String @id @default(cuid())
  sequenceId   String
  position     Int
  templateId   String
  /// Wait after enrollment (step 0) or after the previous step.
  delayMinutes Int    @default(0)

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id])

  @@unique([sequenceId, position])
  @@index([templateId])
}

model SequenceEnrollment {
  id            String    @id @default(cuid())
  sequenceId    String
  contactId     String
  phone         String
  deviceId      String?
  nextStep      Int       @default(0)
  nextRunAt     DateTime?
  /// active | sending | completed | stopped | failed
  status        String    @default("active")
  stoppedReason String?
  lastSentAt    DateTime?
  createdAt     DateTime  @default(now())

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, contactId])
  @@index([status, nextRunAt])
  @@index([phone])
}

// ──────────────────────────────── AI and calls ─────────────────────────────

/// Token usage per model call, for the cost panel and the reply caps.
model AiUsage {
  id               String   @id @default(cuid())
  deviceId         String?
  chatId           String?
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([chatId, createdAt])
  @@index([deviceId, createdAt])
}

/// An AI reply that did not go straight out: awaiting approval, or held by
/// quiet hours until the window ends.
model AiDraft {
  id        String    @id @default(cuid())
  chatId    String
  deviceId  String
  text      String
  /// pending_approval | held | sent | discarded
  status    String
  reason    String?
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([chatId])
}

model CallEvent {
  id       String   @id
  deviceId String
  from     String
  isVideo  Boolean  @default(false)
  rejected Boolean  @default(false)
  replied  Boolean  @default(false)
  at       DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, at])
}

// ───────────────────────────── Inbox productivity (Wave 3) ─────────────────────────────

/// Saved answer inserted from the composer with "/shortcut". Merge tags allowed.
model QuickReply {
  id        String   @id @default(cuid())
  shortcut  String   @unique
  title     String
  body      String
  useCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A private note on a conversation, visible only inside the app.
model ChatNote {
  id        String   @id @default(cuid())
  chatId    String
  body      String
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

/// A one-off reply written now and sent later from the chat window.
model ScheduledMessage {
  id        String    @id @default(cuid())
  chatId    String
  body      String    @default("")
  mediaPath String?
  sendAt    DateTime
  /// scheduled | sending | sent | failed | cancelled
  status    String    @default("scheduled")
  messageId String?
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
  @@index([chatId])
}

// ─────────────────────────────── Chatbot flows (Wave 3) ───────────────────────────────

/// A visual menu flow ("Reply 1 for prices…"). The graph is JSON validated by
/// shared/flow.ts; flows run before keyword rules and the AI bot.
model ChatbotFlow {
  id        String   @id @default(cuid())
  name      String
  enabled   Boolean  @default(true)
  /// keywords | new_chat | any
  trigger   String   @default("keywords")
  keywords  String   @default("[]")
  /// Devices this flow answers on; empty = all.
  deviceIds String   @default("[]")
  priority  Int      @default(0)
  graph     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions FlowSession[]

  @@index([enabled, priority])
}

/// Where a chat currently is inside a flow. One active flow per chat.
model FlowSession {
  chatId    String   @id
  flowId    String
  nodeId    String
  /// Answers collected so far, as JSON.
  vars      String   @default("{}")
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  chat Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  flow ChatbotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
  @@index([expiresAt])
}

// ─────────────────────────── WhatsApp address book (Wave 3) ───────────────────────────

/// Contacts each linked phone knows (its address book and chats), as reported
/// by WhatsApp. The grabber exports these into a contact list.
model WaContact {
  deviceId      String
  jid           String
  phone         String
  name          String?
  /// Saved in the phone's address book.
  inAddressBook Boolean   @default(true)
  /// Has a one-to-one chat with this phone (synced chat list or the inbox).
  hasChat       Boolean   @default(false)
  lastChatAt    DateTime?
  updatedAt     DateTime  @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, jid])
  @@index([phone])
}
